{
  "name": "mindledger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --import ./server/test-bootstrap.cjs --import tsx --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "test": "node --import ./server/test-bootstrap.cjs --import tsx --test server/prompts.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "start": "concurrently -k \"node --import ./server/test-bootstrap.cjs --import tsx server/index.ts\" \"vite preview --host 127.0.0.1\""
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "recharts": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15"
  }
}
